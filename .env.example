# =========================================
# DATABASE
# =========================================
POSTGRES_USER=monitor_user
POSTGRES_PASSWORD=ganti_dengan_password_kuat
POSTGRES_DB=website_monitor
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Dipakai oleh SQLAlchemy untuk konek ke PostgreSQL
DATABASE_URL=postgresql://monitor_user:ganti_dengan_password_kuat@db:5432/website_monitor

# =========================================
# APPLICATION
# =========================================
APP_ENV=development
LOG_LEVEL=INFO

# =========================================
# SECURITY
# Kunci untuk encrypt/decrypt kredensial login website (kolom credentials di tabel websites)
# Generate dengan: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =========================================
ENCRYPTION_KEY=ganti_dengan_key_hasil_generate

# API Key untuk autentikasi semua endpoint (header: X-API-Key)
# Kosongkan untuk menonaktifkan autentikasi (development lokal saja).
# Generate dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# =========================================
# NOTIFICATION - TELEGRAM
# =========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# =========================================
# NOTIFICATION - DISCORD
# =========================================
DISCORD_WEBHOOK_URL=

# =========================================
# NOTIFICATION - EMAIL (SMTP)
# =========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
